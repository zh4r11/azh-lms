# Local Prisma Postgres from `npm run db:start`. Use the port that command prints.
DATABASE_URL="postgres://postgres:postgres@localhost:51226/template1?sslmode=disable"

# Shadow database from the same prisma dev server (the next port up), used by db:migrate.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51227/template1?sslmode=disable"

# prisma dev runs a single-connection server; raise this on a real Postgres.
DATABASE_POOL_MAX=1

# Secret for signing session cookies. Generate one per environment, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me"

# Production only. With both set, uploads go to a private Supabase Storage bucket instead of
# storage/ on disk (Vercel's disk does not keep files). Use the project's secret key
# (Settings > API Keys); never expose it to the browser.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SECRET_KEY=""
# SUPABASE_BUCKET="berkas"
